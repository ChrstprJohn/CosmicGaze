# Vite exposes VITE_ variables in the browser. Never use that prefix for secrets.
VITE_NASA_API_URL=https://science.nasa.gov/wp-json/wp/v2/apod-basic
# The new NASA Science date route currently works without an API key.
# Also used by Cosmic neighbors (NASA NeoWs). DEMO_KEY has shared request limits.
# Keep DEMO_KEY for local previews or supply your public NASA developer key.
VITE_NASA_API_KEY=DEMO_KEY

# Public PostHog project token (not a personal or secret API key).
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=

# Server-only public stats settings (Vercel function). Never prefix with VITE_.
# Keep private keys in ignored local files or sensitive Vercel variables only.
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
